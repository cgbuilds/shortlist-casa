NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
# Alpha chat: OpenRouter Auto (free/cheap routing). Tool calls are not sent to Auto — the built-in coach applies criteria; Auto only writes the recap.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RENTCAST_API_KEY=
# Developer plan includes 50 calls/month. This app hard-stops at 50 (never sends overage at $0.20/call).
RENTCAST_MONTHLY_LIMIT=50
# Beta: 3 live searches per user. Cache does not expire.
RENTCAST_USER_MONTHLY_LIMIT=3
NEXT_PUBLIC_SITE_URL=http://localhost:3000
