NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
# Primary chat recap: OpenRouter Auto (cheap routing). Must-haves are applied by the built-in parser; Auto writes the reply. Groq/OpenAI only if OPENROUTER_API_KEY is unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RENTCAST_API_KEY=
# Developer plan includes 50 calls/month. This app hard-stops at 50 (never sends overage at $0.20/call).
RENTCAST_MONTHLY_LIMIT=50
# Beta: 3 live searches per user. Cache does not expire.
RENTCAST_USER_MONTHLY_LIMIT=3
NEXT_PUBLIC_SITE_URL=https://shortlist.casa
